# ==============================================================================
# Eneba Marketplace Environment & Secret Injection Template
# Copy to .env for local overrides or inject via Docker/Kubernetes secret mounts
# NEVER commit actual secrets or credentials to version control!
# ==============================================================================

APP_ENV=development
PORT=8080
DB_PATH=./data/eneba.db
STATIC_DIR=../frontend/dist
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Option A: Direct Environment Variable Secret Injection (32+ bytes required in production)
JWT_SECRET=
KEY_ENCRYPTION_SECRET=

# Option B: File-based Secret Injection (Docker Swarm / Kubernetes / Compose secrets)
JWT_SECRET_FILE=
KEY_ENCRYPTION_SECRET_FILE=
